filters:
  and:
    - file.folder == "_database/database-core/tasks-table"
views:
  - type: table
    name: Table
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - title
      - status
      - priority
      - file.ext
    sort:
      - property: file.name
        direction: ASC
