filters:
  and:
    - file.folder == "_database/database-core/backlog-table"
views:
  - type: table
    name: Table
    filters:
      and:
        - status != "archived"
        - status != "completed"
    groupBy:
      property: priority
      direction: ASC
    order:
      - file.name
      - status
      - title
      - context
      - category
      - priority
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 89
      note.title: 170
