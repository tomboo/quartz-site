{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "database-docs-schema",
  "title": "Docs Database Schema",
  "description": "Schema for documentation files in the docs database",
  "type": "object",

  "$defs": {
    "uid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "26-character ULID (Crockford Base32)"
    },
    "iso-date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date (YYYY-MM-DD)"
    },
    "iso-datetime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime with timezone"
    },
    "kebab-case": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lowercase kebab-case string"
    },
    "wikilink": {
      "type": "string",
      "pattern": "^\\[\\[.+\\]\\]$",
      "description": "Obsidian wikilink format [[path|alias]] or [[path]]"
    }
  },

  "properties": {
    "uid": {
      "$ref": "#/$defs/uid"
    },
    "date": {
      "$ref": "#/$defs/iso-date",
      "description": "Creation or reference date"
    },
    "user": {
      "$ref": "#/$defs/kebab-case",
      "description": "Username of document owner"
    },
    "type": {
      "const": "doc",
      "description": "Document type identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Document title"
    },
    "slug": {
      "$ref": "#/$defs/kebab-case",
      "description": "URL-friendly identifier for lookup"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "archived", "deprecated"],
      "default": "draft",
      "description": "Document lifecycle status"
    },
    "description": {
      "type": "string",
      "description": "Brief summary for search and listings (1 line)"
    },
    "synopsis": {
      "type": "string",
      "minLength": 50,
      "maxLength": 500,
      "description": "2-3 sentence summary of document content and purpose"
    },
    "category": {
      "$ref": "#/$defs/kebab-case",
      "description": "Document category (architecture, guide, reference, etc.)"
    },
    "doc-type": {
      "type": "string",
      "enum": ["prd", "plan", "guide", "reference", "spec", "notes", "tutorial", "changelog"],
      "description": "Document template/format type"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/kebab-case"
      },
      "uniqueItems": true,
      "default": [],
      "description": "Document tags"
    },
    "project": {
      "$ref": "#/$defs/wikilink",
      "description": "Link to parent project"
    },
    "area": {
      "$ref": "#/$defs/wikilink",
      "description": "Link to life/work area"
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wikilink"
      },
      "description": "Links to related documents"
    },
    "audience": {
      "type": "string",
      "enum": ["internal", "team", "public"],
      "default": "internal",
      "description": "Intended audience for the document"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Document version (semver format)"
    },
    "source": {
      "type": "string",
      "enum": ["original", "notion", "migration", "import"],
      "description": "Origin of the document"
    },
    "source-url": {
      "type": "string",
      "format": "uri",
      "description": "Original source URL if migrated"
    },
    "reviewed-at": {
      "$ref": "#/$defs/iso-datetime",
      "description": "Last review/verification timestamp"
    },
    "created-at": {
      "$ref": "#/$defs/iso-datetime",
      "description": "Creation timestamp"
    }
  },

  "required": ["uid", "type", "title", "status", "slug"],

  "additionalProperties": true
}
